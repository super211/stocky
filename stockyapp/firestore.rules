rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.dailyGoal is number
        && request.resource.data.dailyGoal > 0
        && request.resource.data.dailyGoal <= 20000
        && (!('age' in request.resource.data)
          || (request.resource.data.age is number
            && request.resource.data.age >= 18
            && request.resource.data.age <= 100))
        && (!('weightLb' in request.resource.data)
          || (request.resource.data.weightLb is number
            && request.resource.data.weightLb > 0
            && request.resource.data.weightLb <= 700))
        && (!('gender' in request.resource.data)
          || request.resource.data.gender in ['female', 'male'])
        && (!('weeklyChangeLb' in request.resource.data)
          || (request.resource.data.weeklyChangeLb is number
            && request.resource.data.weeklyChangeLb >= -2
            && request.resource.data.weeklyChangeLb <= 1));
      allow delete: if false;

      match /foods/{foodId} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 60
          && request.resource.data.servingLabel is string
          && request.resource.data.calories is number
          && request.resource.data.calories >= 0;
      }

      match /entries/{entryId} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.meal in ['breakfast', 'lunch', 'dinner', 'snacks']
          && request.resource.data.date is string
          && request.resource.data.servings is number
          && request.resource.data.servings > 0
          && request.resource.data.totalCalories is number
          && request.resource.data.totalCalories >= 0;
      }
    }
  }
}
